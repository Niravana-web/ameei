{
  "$description": "ameei design tokens — Crimson Spice Triad. Source of truth mirrored from web/src/app/globals.css (@theme). Keep both in sync.",
  "color": {
    "primary": {
      "crimson": { "value": "#C0162C", "use": "Brand red. Logo field, headlines on light, primary accents." },
      "crimson-deep": { "value": "#8B0D1E", "use": "Primary buttons/CTAs, logo border, italic headline accent." },
      "crimson-bright": { "value": "#E8192F", "use": "Sparingly — sale flashes, heat callouts." }
    },
    "secondary": {
      "saffron": { "value": "#F4A828", "use": "Highlight, badges, logo inner keyline, glow." },
      "saffron-pale": { "value": "#FDE68A", "use": "Soft backgrounds, gradient ends." },
      "terracotta": { "value": "#C8622A", "use": "Warm supporting tone, spice/roast cues." }
    },
    "neutral": {
      "chalk": { "value": "#FFF8F0", "use": "Default light background (warm off-white, never pure white)." },
      "ink": { "value": "#1A0A0C", "use": "Body text on light." },
      "ash": { "value": "#6B5B5D", "use": "Secondary text." },
      "fog": { "value": "#EDE3E0", "use": "Dividers, subtle panels." }
    },
    "dark-surface": {
      "ember": { "value": "#19090B", "use": "Dark section / dark ad background." },
      "ember-soft": { "value": "#2D1B1D", "use": "Raised panels on dark." },
      "ember-mist": { "value": "#493436", "use": "Borders on dark." },
      "blush": { "value": "#FFB3B1", "use": "Soft accent on dark, gradient washes." },
      "amber-glow": { "value": "#FFB950", "use": "Eyebrow/italic accent text on dark." },
      "rosewood": { "value": "#E0BFBD", "use": "Muted text on dark." }
    },
    "functional": {
      "success": { "value": "#2D7A4F" }
    }
  },
  "font": {
    "display": { "family": "Fraunces", "fallback": "serif", "source": "Google Fonts", "use": "Headlines. Heavy (900) roman + light italic accent." },
    "body": { "family": "DM Sans", "fallback": "sans-serif", "source": "Google Fonts", "use": "Body, UI, uppercase labels." },
    "accent": { "family": "Caveat", "fallback": "cursive", "source": "Google Fonts", "use": "Handwritten notes / stickers. Use rarely." }
  },
  "type-scale": {
    "display-hero": { "size": "clamp(2.5rem, 4.5vw, 4rem)", "lineHeight": 0.96, "letterSpacing": "-0.03em", "weight": 900, "font": "display" },
    "headline-lg": { "size": "clamp(1.75rem, 2.6vw, 2.375rem)", "lineHeight": 1.12, "letterSpacing": "-0.02em", "weight": 700, "font": "display" },
    "headline-md": { "size": "clamp(1.0625rem, 1.4vw, 1.25rem)", "lineHeight": 1.25, "weight": 700, "font": "display" },
    "editorial": { "size": "clamp(1.0625rem, 1.5vw, 1.375rem)", "lineHeight": 1.4, "weight": 400, "font": "display", "style": "italic" },
    "body-lg": { "size": "1.0625rem", "lineHeight": 1.6, "font": "body" },
    "body-md": { "size": "0.9375rem", "lineHeight": 1.6, "font": "body" },
    "label-caps": { "size": "0.6875rem", "lineHeight": 1.3, "letterSpacing": "0.16em", "weight": 700, "font": "body", "transform": "uppercase" }
  },
  "radius": {
    "card": "1rem",
    "photo": "1.25rem",
    "panel": "2rem",
    "pill": "9999px"
  },
  "shadow": {
    "spice": "0 4px 24px rgba(192, 22, 44, 0.12)",
    "spice-lg": "0 20px 40px -10px rgba(192, 22, 44, 0.18)",
    "saffron-glow": "0 8px 30px rgba(244, 168, 40, 0.45)",
    "cta": "0 4px 20px rgba(139, 13, 30, 0.4)"
  },
  "motion": {
    "ease-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "ease-out-soft": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "texture": {
    "film-grain": { "opacity": 0.05, "use": "Fractal-noise overlay on hero/photo areas for analog warmth." }
  }
}
