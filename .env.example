# ---- Database ----
# Local dev uses SQLite. Production: switch provider in prisma/schema.prisma to
# "postgresql" and set this to your Postgres URL.
DATABASE_URL="file:./dev.db"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Clerk (https://dashboard.clerk.com → API keys) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Optional: keep these defaults unless you customize routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ---- Stripe (https://dashboard.stripe.com → Developers → API keys) ----
STRIPE_SECRET_KEY="sk_test_xxx"
# From `stripe listen` (dev) or the Dashboard webhook endpoint (prod).
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ---- AWS S3 (admin product image uploads) ----
# IAM user needs s3:PutObject. For first-run bucket auto-create it also needs
# s3:CreateBucket, s3:PutBucketPolicy, s3:PutPublicAccessBlock.
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="ameei-product-images"
