// ameei data layer. MySQL via the @prisma/adapter-mariadb driver adapter (Prisma 7).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String
  description  String   @db.Text
  category     String // Category union — validated in app layer
  spiceLevel   Int // 1..3
  badge        String? // "BESTSELLER" | "NEW"
  // JSON string columns; typed accessors live in catalog.ts.
  image        String   @db.Text // { src, alt }
  gallery      String   @db.Text // [{ src, alt }]
  weights      String   @db.Text // [{ label, price }] — price in USD
  defaultWeight String
  ingredients  String   @db.Text
  nutrition    String   @db.Text
  shipping     String   @db.Text
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  userId          String? // Clerk user id — who placed it
  email           String?
  amountTotal     Int // cents
  currency        String   @default("usd")
  /// "pending" (checkout opened) | "paid" | "roasting" | "shipped" | "cancelled"
  status          String
  items           String   @db.Text // JSON: [{ slug, name, weight, qty, unitPrice, mixCode?, mixSummary? }]
  createdAt       DateTime @default(now())

  // Copied from the Stripe session once it completes (webhook, success page,
  // or the admin "Sync from Stripe" button), so the roasting queue stands alone.
  customerName    String?
  phone           String?   @db.VarChar(32)
  shippingName    String?
  shippingAddress String?   @db.Text // JSON Stripe Address { line1, line2, city, state, postal_code, country }
  paymentIntentId String?   @db.VarChar(64)

  // Fulfillment, set from /admin/queue.
  roastedAt       DateTime?
  shippedAt       DateTime?
  carrier         String?   @db.VarChar(32)
  trackingNumber  String?   @db.VarChar(64)
  notes           String?   @db.Text

  @@index([userId])
  @@index([status])
}

/// A completed Studio build — the recipe, not a line item. Quantity lives on the
/// cart line, so one mix can be ordered any number of times. No relations: house
/// style here is JSON-in-TEXT with slugs as soft keys (see Product/Order above).
model CustomMix {
  id             String @id @default(cuid())
  /// Share code: Crockford base32, uppercase, 8 chars. node:crypto, never Math.random.
  code           String @unique @db.VarChar(16)
  /// The Product this build attaches to (STUDIO_PRODUCT_SLUG). No FK, by convention.
  productSlug    String
  /// Pack size label — must match both a Product.weights[].label and a STUDIO_SIZES[].label.
  weight         String
  /// JSON: { weight, nuts[], cereals[], extras[], spice, salt }, canonically sorted.
  selection      String @db.Text
  /// describeMix() output, denormalized so a later relabel can't rewrite history.
  summary        String @db.Text
  /// Quote at build time. AUDIT AND DISPLAY ONLY — checkout re-prices from studio.ts.
  priceCents     Int
  /// STUDIO_PRICING_VERSION when built; lets a shared build warn that prices moved.
  pricingVersion Int    @default(1)
  /// sha256(canonicalMixKey) — identical builds collapse to one row and one code.
  fingerprint    String @unique @db.VarChar(64)
  /// Clerk id of the FIRST builder. Dedupe means this is not ownership — derive
  /// "my mixes" from Order.items instead. Nullable: anonymous builds are allowed.
  userId         String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([productSlug, createdAt])
}

/// Newsletter signup captured from the site (footer by default). Email is
/// lowercased and trimmed in the API layer before write; unique so re-subscribing
/// is an idempotent upsert, never an error.
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(254)
  /// Where the signup came from: "footer" | future values ("popup", "checkout", ...).
  source    String   @default("footer") @db.VarChar(32)
  /// Reserved for a later preference field (e.g. "mild" | "medium" | "hot").
  heat      String?  @db.VarChar(16)
  createdAt DateTime @default(now())
}
