// ameei data layer. MySQL via the @prisma/adapter-mariadb driver adapter (Prisma 7).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String
  description  String   @db.Text
  category     String // Category union — validated in app layer
  spiceLevel   Int // 1..3
  badge        String? // "BESTSELLER" | "NEW"
  // JSON string columns; typed accessors live in catalog.ts.
  image        String   @db.Text // { src, alt }
  gallery      String   @db.Text // [{ src, alt }]
  weights      String   @db.Text // [{ label, price }] — price in USD
  defaultWeight String
  ingredients  String   @db.Text
  nutrition    String   @db.Text
  shipping     String   @db.Text
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  userId          String? // Clerk user id — who placed it
  email           String?
  amountTotal     Int // cents
  currency        String   @default("usd")
  status          String // "paid" | "pending" | ...
  items           String   @db.Text // JSON: [{ slug, name, weight, qty, unitPrice }]
  createdAt       DateTime @default(now())

  @@index([userId])
}

/// A completed Studio build — the recipe, not a line item. Quantity lives on the
/// cart line, so one mix can be ordered any number of times. No relations: house
/// style here is JSON-in-TEXT with slugs as soft keys (see Product/Order above).
model CustomMix {
  id             String @id @default(cuid())
  /// Share code: Crockford base32, uppercase, 8 chars. node:crypto, never Math.random.
  code           String @unique @db.VarChar(16)
  /// The Product this build attaches to (STUDIO_PRODUCT_SLUG). No FK, by convention.
  productSlug    String
  /// Pack size label — must match both a Product.weights[].label and a STUDIO_SIZES[].label.
  weight         String
  /// JSON: { weight, nuts[], cereals[], extras[], spice, salt }, canonically sorted.
  selection      String @db.Text
  /// describeMix() output, denormalized so a later relabel can't rewrite history.
  summary        String @db.Text
  /// Quote at build time. AUDIT AND DISPLAY ONLY — checkout re-prices from studio.ts.
  priceCents     Int
  /// STUDIO_PRICING_VERSION when built; lets a shared build warn that prices moved.
  pricingVersion Int    @default(1)
  /// sha256(canonicalMixKey) — identical builds collapse to one row and one code.
  fingerprint    String @unique @db.VarChar(64)
  /// Clerk id of the FIRST builder. Dedupe means this is not ownership — derive
  /// "my mixes" from Order.items instead. Nullable: anonymous builds are allowed.
  userId         String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([productSlug, createdAt])
}
